{
  "name": "@adserve/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-helpers": "./src/test-helpers/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "seed": "tsx src/seed/run.ts",
    "seed:backfill-admin-access": "tsx src/seed/backfill-admin-access.ts",
    "seed:backfill-ai-usage-read": "tsx src/seed/backfill-ai-usage-read.ts",
    "seed:backfill-crm-admin": "tsx src/seed/backfill-crm-admin.ts",
    "seed:dedupe-platform-permissions": "tsx src/seed/dedupe-platform-permissions.ts",
    "sql:rls": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f sql/001-enable-rls.sql",
    "sql:rls-test-role": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f sql/002-create-rls-test-role.sql",
    "sql:dev-rls-roles": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f sql/dev-rls-roles.sql",
    "sql:reconcile-cardinality": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f sql/007-reconcile-crm-cardinality.sql",
    "sql:unique-relationship-name": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f sql/008-unique-relationship-name.sql",
    "db:rls-dev-parity": "pnpm sql:rls && pnpm sql:dev-rls-roles",
    "studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
