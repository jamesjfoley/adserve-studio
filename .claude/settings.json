{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "Edit(**)",
      "Write(**)",
      "Read(**)",
      "WebFetch(*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(sudo:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push origin main:*)"
    ]
  }
}
