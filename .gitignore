# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
dist/
out/
.turbo/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Claude Code local session state (but track shared agent definitions).
# Ignore the CONTENTS of .claude (.claude/*), not the dir itself, so the
# negations below can re-include .claude/agents/** — a trailing-slash `.claude/`
# excludes the parent dir and makes the re-includes ineffective for new files.
.claude/*
!.claude/agents/
!.claude/agents/**

# Local-only generated state (e.g. AWS resource ID captures)
*.local

# Logs
*.log
npm-debug.log*

# Testing
coverage/

# Database
packages/database/drizzle/

# Docker volumes (shouldn't be in repo but just in case)
postgres_data/
redis_data/
