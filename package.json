{
  "name": "adserve-studio",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @adserve/database generate",
    "db:migrate": "pnpm --filter @adserve/database migrate",
