    "db:studio": "pnpm --filter @adserve/database studio"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
